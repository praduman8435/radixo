# Leave both empty to run in demo mode (data stays in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave false while testing without a WhatsApp/SMS provider: the OTP screen accepts any code.
# Set to true after enabling Phone auth (Twilio / WhatsApp) in Supabase → Authentication → Providers.
VITE_OTP_REQUIRED=false
